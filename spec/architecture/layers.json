{
  "schemaVersion": 2,
  "principle": "ONE RESPONSIBILITY → ONE OWNER → ONE AUTHORITATIVE SOURCE → ONE IMPLEMENTATION PATH",
  "layers": {
    "presentation": ["src/views/", "src/components/", "src/stores/", "src/layouts/", "src/presentation/"],
    "application": ["src/application/"],
    "domain": ["src/domain/"],
    "repositories": ["src/repositories/"],
    "infrastructure": ["src/infrastructure/"],
    "legacyServices": ["src/services/"],
    "localDatabase": ["src/utils/indexedDB.js"],
    "futureIntegrations": []
  },
  "canonicalRuntimeFlow": ["presentation", "application", "domain", "repositories", "localDatabase"],
  "allowedImports": {
    "presentation": ["application", "domain", "infrastructure"],
    "application": ["domain", "repositories", "infrastructure"],
    "domain": [],
    "repositories": ["localDatabase"],
    "infrastructure": ["repositories", "localDatabase", "futureIntegrations"],
    "legacyServices": [],
    "localDatabase": [],
    "futureIntegrations": []
  },
  "forbiddenDependencies": [
    ["domain", "presentation"],
    ["domain", "application"],
    ["domain", "repositories"],
    ["domain", "infrastructure"],
    ["domain", "localDatabase"],
    ["application", "presentation"],
    ["application", "localDatabase"],
    ["presentation", "repositories"],
    ["presentation", "localDatabase"],
    ["legacyServices", "canonicalRuntime"]
  ],
  "directPersistenceForbiddenIn": ["src/views/", "src/components/", "src/stores/", "src/layouts/", "src/presentation/", "src/application/", "src/domain/"],
  "directBusinessCalculationForbiddenIn": ["src/views/", "src/components/", "src/stores/", "src/layouts/", "src/presentation/"],
  "notes": [
    "src/services/ is retained only where a verified future migration has not yet occurred; canonical KFE runtime must not depend on it.",
    "UI/UX and shell remain decoupled from infrastructure providers.",
    "External providers must be reached through replaceable infrastructure adapters."
  ]
}
