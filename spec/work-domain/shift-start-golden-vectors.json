{
  "schemaVersion": 1,
  "purpose": "Shared golden vectors for shift-start and shift-end odometer validity.",
  "cases": [
    {
      "id": "previous-odometer-positive-gap",
      "rule": "validateShiftStartOdometer",
      "input": {
        "currentOdometer": 120,
        "previousOdometer": 100
      },
      "expected": {
        "valid": true,
        "gapKm": 20
      }
    },
    {
      "id": "previous-odometer-equal",
      "rule": "validateShiftStartOdometer",
      "input": {
        "currentOdometer": 100,
        "previousOdometer": 100
      },
      "expected": {
        "valid": true,
        "gapKm": 0
      }
    },
    {
      "id": "previous-odometer-missing",
      "rule": "validateShiftStartOdometer",
      "input": {
        "currentOdometer": 120,
        "previousOdometer": null
      },
      "expected": {
        "valid": true,
        "gapKm": 0
      }
    },
    {
      "id": "current-odometer-zero",
      "rule": "validateShiftStartOdometer",
      "input": {
        "currentOdometer": 0,
        "previousOdometer": 100
      },
      "expected": {
        "valid": false,
        "reasonCode": "INVALID_CURRENT_ODOMETER"
      }
    },
    {
      "id": "current-below-previous",
      "rule": "validateShiftStartOdometer",
      "input": {
        "currentOdometer": 99,
        "previousOdometer": 100
      },
      "expected": {
        "valid": false,
        "reasonCode": "BELOW_PREVIOUS_ODOMETER"
      }
    },
    {
      "id": "first-day-historical-gap",
      "rule": "validateFirstDayShiftStartOdometer",
      "input": {
        "currentOdometer": 125,
        "businessStartOdometer": 100
      },
      "expected": {
        "valid": true,
        "gapKm": 25,
        "historicalKm": 25,
        "businessStartOdometer": 100,
        "historicalOdometerGap": true
      }
    },
    {
      "id": "first-day-no-baseline",
      "rule": "validateFirstDayShiftStartOdometer",
      "input": {
        "currentOdometer": 125,
        "businessStartOdometer": null
      },
      "expected": {
        "valid": true,
        "gapKm": 0,
        "historicalKm": 0,
        "businessStartOdometer": null,
        "historicalOdometerGap": false
      }
    },
    {
      "id": "first-day-current-below-business-start",
      "rule": "validateFirstDayShiftStartOdometer",
      "input": {
        "currentOdometer": 99,
        "businessStartOdometer": 100
      },
      "expected": {
        "valid": false,
        "reasonCode": "BELOW_BUSINESS_START_ODOMETER"
      }
    },
    {
      "id": "end-shift-closing-odometer-missing",
      "rule": "validateEndShiftEntry",
      "input": {
        "closingOdometer": null,
        "startOdometer": 100
      },
      "expected": {
        "valid": false,
        "reasonCode": "CLOSING_ODOMETER_REQUIRED"
      }
    },
    {
      "id": "end-shift-closing-odometer-blank",
      "rule": "validateEndShiftEntry",
      "input": {
        "closingOdometer": "   ",
        "startOdometer": 100
      },
      "expected": {
        "valid": false,
        "reasonCode": "CLOSING_ODOMETER_REQUIRED"
      }
    },
    {
      "id": "end-shift-closing-odometer-nonnumeric",
      "rule": "validateEndShiftEntry",
      "input": {
        "closingOdometer": "not-a-number",
        "startOdometer": 100
      },
      "expected": {
        "valid": false,
        "reasonCode": "CLOSING_ODOMETER_REQUIRED"
      }
    },
    {
      "id": "end-shift-closing-odometer-negative",
      "rule": "validateEndShiftEntry",
      "input": {
        "closingOdometer": -1,
        "startOdometer": 100
      },
      "expected": {
        "valid": false,
        "reasonCode": "CLOSING_ODOMETER_REQUIRED"
      }
    },
    {
      "id": "end-shift-closing-below-start",
      "rule": "validateEndShiftEntry",
      "input": {
        "closingOdometer": 99,
        "startOdometer": 100
      },
      "expected": {
        "valid": false,
        "reasonCode": "CLOSING_ODOMETER_BELOW_START"
      }
    },
    {
      "id": "end-shift-equal-odometer",
      "rule": "validateEndShiftEntry",
      "input": {
        "closingOdometer": 100,
        "startOdometer": 100
      },
      "expected": {
        "valid": true,
        "closingOdometer": 100,
        "distanceKm": 0
      }
    },
    {
      "id": "end-shift-exactly-500-km",
      "rule": "validateEndShiftEntry",
      "input": {
        "closingOdometer": 600,
        "startOdometer": 100
      },
      "expected": {
        "valid": true,
        "closingOdometer": 600,
        "distanceKm": 500
      }
    },
    {
      "id": "end-shift-over-500-needs-confirmation",
      "rule": "validateEndShiftEntry",
      "input": {
        "closingOdometer": 601,
        "startOdometer": 100
      },
      "expected": {
        "valid": false,
        "requiresConfirmation": true,
        "distanceKm": 501,
        "reasonCode": "LARGE_DISTANCE_CONFIRMATION_REQUIRED"
      }
    },
    {
      "id": "end-shift-over-500-confirmed",
      "rule": "validateEndShiftEntry",
      "input": {
        "closingOdometer": 601,
        "startOdometer": 100,
        "confirmLargeDistance": true
      },
      "expected": {
        "valid": true,
        "closingOdometer": 601,
        "distanceKm": 501
      }
    },
    {
      "id": "end-shift-missing-start-baseline",
      "rule": "validateEndShiftEntry",
      "input": {
        "closingOdometer": 120
      },
      "expected": {
        "valid": true,
        "closingOdometer": 120,
        "distanceKm": null
      }
    },
    {
      "id": "end-shift-null-start-baseline-coerces-zero",
      "rule": "validateEndShiftEntry",
      "input": {
        "closingOdometer": 120,
        "startOdometer": null
      },
      "expected": {
        "valid": true,
        "closingOdometer": 120,
        "distanceKm": 120
      }
    },
    {
      "id": "end-shift-blank-start-baseline-coerces-zero",
      "rule": "validateEndShiftEntry",
      "input": {
        "closingOdometer": 120,
        "startOdometer": "   "
      },
      "expected": {
        "valid": true,
        "closingOdometer": 120,
        "distanceKm": 120
      }
    }
  ]
}
